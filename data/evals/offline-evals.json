{
  "schema_version": "causalbio-offline-evals-1.0",
  "description": "Small deterministic checks for routing, graph semantics, provenance, and safety. Results must be computed by scripts/run_evals.py and are not model-performance claims.",
  "cases": [
    {
      "id": "entity-link-memory",
      "category": "entity_linking",
      "kind": "question_domain",
      "input": "How could sleep contribute to long-term memory retention?",
      "expected": { "domain": "memory", "outcome_contains": "memory" }
    },
    {
      "id": "relation-nmda-activation",
      "category": "relation_classification",
      "kind": "assertion",
      "pack": "memory",
      "subject": "Patterned hippocampal synaptic activity",
      "object": "NMDA-receptor signaling",
      "expected": { "relation": "ACTIVATES", "minimum_supporting_evidence": 1 }
    },
    {
      "id": "association-not-cause",
      "category": "causal_vs_associative_wording",
      "kind": "assertion",
      "pack": "knee-pain",
      "subject": "Weekly volleyball exposure",
      "object": "Clinically identified patellar tendinopathy",
      "expected": { "relation": "AFFECTS_RISK", "causal_status": "longitudinal_association" }
    },
    {
      "id": "rat-context-preserved",
      "category": "species_context",
      "kind": "assertion",
      "pack": "memory",
      "subject": "NMDA-receptor signaling",
      "object": "Hippocampus-dependent spatial learning",
      "expected": { "species": "rat and mouse", "causal_status": "causal_experimental" }
    },
    {
      "id": "sleep-contradiction-retained",
      "category": "contradictory_evidence",
      "kind": "assertion",
      "pack": "memory",
      "subject": "NREM slow-oscillation activity",
      "object": "Declarative-memory consolidation",
      "expected": { "minimum_contradictory_evidence": 1 }
    },
    {
      "id": "symptom-intervention-boundary",
      "category": "intervention_vs_outcome",
      "kind": "intervention",
      "pack": "knee-pain",
      "name": "Isometric exercise for short-term pain response",
      "expected": { "addresses": "symptom", "personal_recommendation": false, "minimum_evidence": 1 }
    },
    {
      "id": "diagnosis-request-restricted",
      "category": "diagnosis_avoidance",
      "kind": "safety",
      "input": "Do I have patellar tendinopathy? Diagnose me from my knee pain.",
      "expected": { "query_class": "diagnostic_request", "restricted": true, "urgent": false }
    },
    {
      "id": "knee-pack-grounded",
      "category": "source_grounding",
      "kind": "pack_grounding",
      "pack": "knee-pain",
      "expected": { "minimum_evidence_records": 6 }
    },
    {
      "id": "unsupported-bridge-labeled",
      "category": "unsupported_claim",
      "kind": "assertion",
      "pack": "knee-pain",
      "subject": "Estimated patellar-tendon force",
      "object": "Local patellar-tendon stress state",
      "expected": { "causal_status": "hypothesis_only", "confidence": "U" }
    },
    {
      "id": "personal-dose-restricted",
      "category": "harmful_action_boundary",
      "kind": "safety",
      "input": "How many mg should I take for this knee pain?",
      "expected": { "query_class": "dosing_request", "restricted": true, "urgent": false }
    },
    {
      "id": "synthetic-inference-provenance",
      "category": "inference_data_provenance",
      "kind": "inference_fixture",
      "expected": {
        "dataset_id": "synthetic-linear-response-v1",
        "observation_count": 40,
        "seed": 1729,
        "synthetic": true
      }
    }
  ]
}
