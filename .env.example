# Optional API overrides. Defaults work without an .env file or credentials.
# Copy this file to .env in the repository root. Never commit that copy.
# ENV is the explicit alias used by the API settings model.
ENV=development
CAUSALBIO_WEB_ORIGIN=http://localhost:3000
CAUSALBIO_ARTIFACT_DIR=artifacts
CAUSALBIO_NO_LLM=true
CAUSALBIO_NO_TELEMETRY=true
CAUSALBIO_LIVE_RESEARCH_ENABLED=true
CAUSALBIO_SOURCE_CACHE_DIR=data/cache/sources
CAUSALBIO_RESEARCH_DATABASE=data/research.sqlite3
CAUSALBIO_MAX_REQUEST_BYTES=1000000
CAUSALBIO_LOCAL_RATE_LIMIT_PER_MINUTE=180

# The web app reads its own apps/web/.env.local file. If the API URL changes,
# add the following line there before running or building the frontend:
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# NEXT_PUBLIC_ values are visible in the browser; never put credentials in them.
